# Terraform working files
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Local variable files can hold account IDs and emails; commit only the examples.
*.tfvars
*.tfvars.json
!*.example.tfvars
# Per-environment settings for the example workload hold no account IDs or emails.
!workload/envs/*.tfvars

# Packaged source uploaded by CI
source.zip

.DS_Store

# Bootstrap backend files are written in CloudShell after the first apply (see README).
bootstrap/*/backend.tf
