# Single source of truth for tool versions.
# Used by tools-image/Dockerfile (as build args) and by the scripts in scripts/.
# When you bump a version, update its SHA256 too. The checksums come from the
# publishers' own checksum files (links in the comments).

# https://releases.hashicorp.com/terraform/1.17.1/terraform_1.17.1_SHA256SUMS
TERRAFORM_VERSION=1.17.1
TERRAFORM_SHA256_AMD64=4638628058e71a55212b1c563712eac03b902128f40740f3dc8174df12135061
TERRAFORM_SHA256_ARM64=988e950a1c23058093b0e66ab2d5fb53fc18345ecfbd5871acf51dbac9325edd

